{
  "grammars": [
    {
      "name": "nabion",
      "camelcase": "Nabion",
      "title": "NABION",
      "scope": "source.nabion",
      "path": ".",
      "file-types": ["nabion", "nabi.lock"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^nabion$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "NABION grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nabi-lang/nabi-syntax"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
